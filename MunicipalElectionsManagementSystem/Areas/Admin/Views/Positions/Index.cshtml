@model IEnumerable<MunicipalElectionsManagementSystem.Models.Position>

@{
    ViewData["Title"] = "Manage Positions";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container mt-4">
    <div class="d-flex flex-wrap gap-2 justify-content-between align-items-center mb-4">
        <h2>Manage Positions</h2>

        <a asp-area="Admin" asp-controller="Positions" asp-action="Create" class="btn btn-primary">
            Add Position
        </a>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success">
            @TempData["SuccessMessage"]
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger">
            @TempData["ErrorMessage"]
        </div>
    }

    <table class="table table-striped align-middle table-stack">
        <thead>
            <tr>
                <th>Position</th>
                <th>Municipality</th>
                <th>Seats Available</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var position in Model)
            {
                <tr>
                    <td data-label="Position">@position.Name</td>
                    <td data-label="Municipality">@position.Municipality?.Name</td>
                    <td data-label="Seats Available">@position.SeatsAvailable</td>
                    <td class="actions">
                        <a asp-action="Details" asp-route-id="@position.PositionId" class="btn btn-sm btn-outline-info">
                            Details
                        </a>

                        <a asp-action="Edit" asp-route-id="@position.PositionId" class="btn btn-sm btn-outline-primary">
                            Edit
                        </a>

                        <a asp-action="Delete" asp-route-id="@position.PositionId" class="btn btn-sm btn-outline-danger">
                            Delete
                        </a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>