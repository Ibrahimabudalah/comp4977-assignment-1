@model MunicipalElectionsManagementSystem.ViewModels.UserFormViewModel

@{
    ViewData["Title"] = "Add Administrator";
}

<div class="container mt-4">
    <h2>Add Administrator</h2>
    <p class="text-muted">Create an admin account and choose its admin group.</p>

    <form asp-action="Create" method="post">
        <partial name="_UserForm" model="Model" />

        <button type="submit" class="btn btn-primary">Create Administrator</button>
        <a asp-action="Index" class="btn btn-secondary">Cancel</a>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
