@model MunicipalElectionsManagementSystem.ViewModels.CandidateFormViewModel

@{
    ViewData["Title"] = "Edit Candidate";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container mt-4">
    <h2>Edit Candidate</h2>

    <form method="post" enctype="multipart/form-data">
        @Html.AntiForgeryToken()

        <div asp-validation-summary="ModelOnly" class="text-danger"></div>

        <div class="mb-3">
            <label asp-for="Name" class="form-label"></label>
            <input asp-for="Name" class="form-control" />
            <span asp-validation-for="Name" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="Profile" class="form-label"></label>
            <textarea asp-for="Profile" class="form-control" rows="5"></textarea>
            <span asp-validation-for="Profile" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="Website" class="form-label"></label>
            <input asp-for="Website" type="url" class="form-control" />
            <span asp-validation-for="Website" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="Email" class="form-label"></label>
            <input asp-for="Email" type="email" class="form-control" />
            <span asp-validation-for="Email" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="PositionId" class="form-label">
                Position
            </label>
            <select asp-for="PositionId" asp-items="ViewBag.Positions" class="form-select">
                <option value="">Select Position</option>
            </select>
            <span asp-validation-for="PositionId" class="text-danger"></span>
        </div>

        @if (!string.IsNullOrEmpty(Model.ExistingPhotoFileName))
        {
            <div class="mb-3">
                <label class="form-label">Current Photo</label>
                <div>
                    <img src="@Url.Content("~/uploads/candidates/" + Model.ExistingPhotoFileName)"
                         alt="Current candidate photo" class="img-thumbnail"
                         style="max-width: 150px; max-height: 150px; object-fit: cover;" />
                </div>
            </div>
        }

        <div class="mb-3">
            <label asp-for="Photo" class="form-label">
                Replace Photo
            </label>
            <input asp-for="Photo" type="file" accept=".jpg,.jpeg,.png,.webp" class="form-control" />
            <span asp-validation-for="Photo" class="text-danger"></span>
            <div class="form-text">
                Leave empty to keep the existing photo.
                Maximum size: 2 MB.
            </div>
        </div>

        <button type="submit" class="btn btn-primary">
            Save Changes
        </button>

        <a asp-action="Index" class="btn btn-secondary">
            Cancel
        </a>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}