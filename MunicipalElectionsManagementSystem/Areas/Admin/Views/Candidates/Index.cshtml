@model IEnumerable<MunicipalElectionsManagementSystem.Models.Candidate>

@{
    ViewData["Title"] = "Manage Candidates";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container mt-4">
    <div class="d-flex flex-wrap gap-2 justify-content-between align-items-center mb-4">
        <h2>Manage Candidates</h2>

        <a asp-area="Admin" asp-controller="Candidates" asp-action="Create" class="btn btn-primary">
            Add Candidate
        </a>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success">
            @TempData["SuccessMessage"]
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger">
            @TempData["ErrorMessage"]
        </div>
    }

    <div class="table-responsive">
        <table class="table table-striped align-middle table-stack">
            <thead>
                <tr>
                    <th>Photo</th>
                    <th>Name</th>
                    <th>Position</th>
                    <th>Municipality</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var candidate in Model)
                {
                    <tr>
                        <td data-label="Photo">
                            @if (!string.IsNullOrEmpty(candidate.PhotoFileName))
                            {
                                <img src="@Url.Content("~/uploads/candidates/" + candidate.PhotoFileName)" alt="@candidate.Name"
                                     width="60" height="60" style="object-fit: cover;" class="rounded" />
                            }
                            else
                            {
                                <span class="text-muted">No photo</span>
                            }
                        </td>
                        <td data-label="Name">@candidate.Name</td>
                        <td data-label="Position">@candidate.Position?.Name</td>
                        <td data-label="Municipality">@candidate.Position?.Municipality?.Name</td>
                        <td class="actions">
                            <a asp-action="Details" asp-route-id="@candidate.CandidateId"
                               class="btn btn-sm btn-outline-info">
                                Details
                            </a>

                            <a asp-action="Edit" asp-route-id="@candidate.CandidateId"
                               class="btn btn-sm btn-outline-primary">
                                Edit
                            </a>

                            <a asp-action="Delete" asp-route-id="@candidate.CandidateId"
                               class="btn btn-sm btn-outline-danger">
                                Delete
                            </a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>