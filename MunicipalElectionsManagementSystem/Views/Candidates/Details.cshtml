@model MunicipalElectionsManagementSystem.Models.Candidate

@{
    ViewData["Title"] = Model.Name;
}

<partial name="_StatusMessages" />

<div class="row g-4">
    <div class="col-md-4">
        <img src="@Url.Content(string.IsNullOrEmpty(Model.PhotoFileName)
                      ? "~/images/placeholder.svg"
                      : "~/uploads/candidates/" + Model.PhotoFileName)"
             alt="@Model.Name" class="img-fluid rounded shadow-sm w-100"
             style="max-height: 400px; object-fit: cover;" />
    </div>
    <div class="col-md-8">
        <h2 class="mb-1">@Model.Name</h2>
        <p class="text-muted">
            Candidate for @Model.Position.Name in
            <a asp-controller="Municipalities" asp-action="Details"
               asp-route-id="@Model.Position.MunicipalityId">@Model.Position.Municipality.Name</a>
            &middot; Election @Model.Position.Municipality.ElectionDate.ToString("MMMM d, yyyy")
        </p>

        <h5>Biography</h5>
        <p style="white-space: pre-line;">@Model.Profile</p>

        @if (!string.IsNullOrEmpty(Model.Website) || !string.IsNullOrEmpty(Model.Email))
        {
            <h5>Contact</h5>
            <ul class="list-unstyled">
                @if (!string.IsNullOrEmpty(Model.Website))
                {
                    <li>Website: <a href="@Model.Website" target="_blank" rel="noopener noreferrer">@Model.Website</a></li>
                }
                @if (!string.IsNullOrEmpty(Model.Email))
                {
                    <li>Email: <a href="mailto:@Model.Email">@Model.Email</a></li>
                }
            </ul>
        }

        <form asp-controller="VotingGuide" asp-action="Add" method="post" class="mb-3">
            <input type="hidden" name="id" value="@Model.CandidateId" />
            <input type="hidden" name="returnUrl" value="@Context.Request.Path" />
            <button type="submit" class="btn btn-success">Add to my guide</button>
        </form>

        <a asp-action="Index" class="btn btn-link px-0">&larr; All candidates</a>
    </div>
</div>
